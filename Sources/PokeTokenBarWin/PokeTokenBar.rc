// Windows resources of PokeTokenBar.exe: version info (Windows shows FileDescription as the name of a notification's
// source), the app icon and the manifest. Compiled by scripts/windows/build-resources.ps1, which writes
// ptb-version.rci (PTB_VERSION_COMMA, PTB_VERSION_TEXT) next to the .res and passes its folder with /I.
// No Windows SDK headers are included on purpose: rc.exe then needs no INCLUDE environment.
#include "ptb-version.rci"

1 ICON "..\\..\\assets\\AppIcon.ico"
1 24 "app.manifest"   // RT_MANIFEST

1 VERSIONINFO
 FILEVERSION PTB_VERSION_COMMA
 PRODUCTVERSION PTB_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L      // VOS_NT_WINDOWS32
 FILETYPE 0x1L        // VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "likelion-campus"
            VALUE "FileDescription", "PokeTokenBar"
            VALUE "FileVersion", PTB_VERSION_TEXT
            VALUE "InternalName", "PokeTokenBar"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "PokeTokenBar.exe"
            VALUE "ProductName", "PokeTokenBar"
            VALUE "ProductVersion", PTB_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
