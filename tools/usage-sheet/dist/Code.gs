    d.tools.forEach(function (t) {
      rawItems.push({
        key: member.id + "|" + d.date + "|" + t.tool,
        build: function () {
          return [member.id, member.nickname, d.date, t.tool, d.team, t.input, t.output, t.cacheWrite, t.cacheRead,
            t.input + t.output + t.cacheWrite + t.cacheRead, member.appVersion, member.platform, now];
        }
      });
    });
    if (!teamLabelFor.has(d.team)) teamLabelFor.set(d.team, "");
    if (d.teamLabel && !teamLabelFor.get(d.team)) teamLabelFor.set(d.team, d.teamLabel);
  });
  p.limits.forEach(function (l) { if (!teamLabelFor.has(l.team)) teamLabelFor.set(l.team, ""); });

  // The raw build ignores the old row, so only the key columns (A:D) are read.
  upsertRows(ss.getSheetByName(TAB_RAW), COLS_RAW.length, function (r) {
    return r[0] + "|" + cellToDateString(r[2], tz) + "|" + r[3];
  }, rawItems, { readWidth: 4 });

  upsertLimits(ss.getSheetByName(TAB_LIMITS), member, p.limits);

  // 합칠대상 (D) belongs to the owner: a report writes B:C and E:F only.
  upsertRows(ss.getSheetByName(TAB_PEOPLE), COLS_PEOPLE.length, function (r) { return r[0]; }, [{
    key: member.id,
    build: function (old) {
      return [member.id, member.nickname, now, old === null ? "" : old[3], member.appVersion, member.platform];
    }
  }], { spans: [[2, 2], [5, 2]] });

  var deptItems = [];
  teamLabelFor.forEach(function (label, team) {
    deptItems.push({
      key: team,
      build: function (old) { return old === null ? [team, "", label, localDateString(nowMs, tz)] : old; }
    });
  });
  upsertRows(ss.getSheetByName(TAB_DEPTS), COLS_DEPTS.length, function (r) { return r[0]; }, deptItems);

  var labelItems = [];
  var seen = new Set();
  p.days.forEach(function (d) {
    if (!d.teamLabel || seen.has(d.team)) return;
    seen.add(d.team);
    labelItems.push({
      key: d.team + "|" + member.id,
      build: function () { return [d.team, member.id, d.teamLabel, now]; }
    });
  });
  upsertRows(ss.getSheetByName(TAB_TEAMLABELS), COLS_TEAMLABELS.length, function (r) { return r[0] + "|" + r[1]; }, labelItems);

  return { ok: true, accepted: { days: rawItems.length, limits: p.limits.length }, dropped: p.dropped };
}

function handleReport(ss, text, nowMs, tz) {
  // Parsing needs no sheet, so it runs before the lock is taken.
  var p = parsePayload(text, nowMs, tz);
  if (!p.ok) return { ok: false, error: p.error };
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    ensureSheets(ss);
    if (!checkDevice(ss.getSheetByName(TAB_DEVICES), p.member, nowMs)) return { ok: false, error: "device_mismatch" };
    return writeReport(ss, p, nowMs, tz);
  } finally {
    lock.releaseLock();
  }
}

// Normalized view of every data tab for the dashboards and the plan.
function readAll(ss, tz) {
  function rowsOf(name, cols, spans) {
    var sheet = ss.getSheetByName(name);
    if (!sheet) return [];
    return spans ? sheetColumns(sheet, spans) : sheetRows(sheet, cols.length);
  }
  // Only the columns the dashboards use: memberId..팀ID (A:E) and 합계 (J).
  var usage = rowsOf(TAB_RAW, COLS_RAW, [[1, 5], [10, 1]]).map(function (r) {
    return { memberId: r[0], date: cellToDateString(r[2], tz), tool: r[3], team: r[4], total: Number(r[9]) || 0 };
  });
  var limits = rowsOf(TAB_LIMITS, COLS_LIMITS).map(function (r) {
    return {
      account: r[0], tool: r[1], resetsAt: cellToMs(r[2]), memberId: r[3], team: r[4], plan: r[5], domain: r[6],
      maxUsed: Number(r[7]) || 0, lastUsed: Number(r[8]) || 0, lastReadAt: cellToMs(r[9])
    };
  });
  var people = Object.create(null);
  rowsOf(TAB_PEOPLE, COLS_PEOPLE).forEach(function (r) {
    people[r[0]] = { nickname: String(r[1]), mergeInto: String(r[3] === undefined ? "" : r[3]).trim() };
  });
  var depts = Object.create(null);
  rowsOf(TAB_DEPTS, COLS_DEPTS).forEach(function (r) {
    depts[r[0]] = { name: String(r[1]).trim(), suggested: String(r[2]) };
  });
  var teamLabels = rowsOf(TAB_TEAMLABELS, COLS_TEAMLABELS).map(function (r) {
    return { team: r[0], memberId: r[1], label: String(r[2]) };
  });
  var settings = parseSettings(rowsOf(TAB_SETTINGS, COLS_SETTINGS));
  return { usage: usage, limits: limits, people: people, depts: depts, teamLabels: teamLabels, settings: settings };
}

// Period dashboards: pure computation (periodRange, computeDashboard) plus the sheet writer.
// All date math runs on "yyyy-MM-dd" strings through Date.UTC, never local-time Dates.

var TOKEN_FORMAT = '#,##0.0,,"M"';
var MAX_MERGE_HOPS = 5;
var SORTED_COL = 20;
var CHART_WIDTH = 480;
var CHART_HEIGHT = 300;

function dayNumberToString(n) {
  var d = new Date(n * DAY_MS);
  var m = d.getUTCMonth() + 1, day = d.getUTCDate();
  return d.getUTCFullYear() + "-" + (m < 10 ? "0" : "") + m + "-" + (day < 10 ? "0" : "") + day;
}

function monthStartNumber(y, m0) { return Date.UTC(y, m0, 1) / DAY_MS; }

function periodRange(kind, today) {
  var t = dateToDayNumber(today);
  var y = Number(today.slice(0, 4)), m0 = Number(today.slice(5, 7)) - 1;
  var start, end, prevStart, prevEnd, label;
  if (kind === "last7") {
    start = t - 6; end = t; prevStart = t - 13; prevEnd = t - 7; label = "지난 7일";
  } else if (kind === "lastMonth") {
    var thisStart = monthStartNumber(y, m0);
    var prevMonthStart = monthStartNumber(y, m0 - 1);
    start = prevMonthStart; end = thisStart - 1;
    prevStart = monthStartNumber(y, m0 - 2); prevEnd = prevMonthStart - 1;
    label = "지난달";
  } else {
    var monthStart = monthStartNumber(y, m0);
    var pStart = monthStartNumber(y, m0 - 1);
    var prevLen = monthStart - pStart;
    var dayOfMonth = t - monthStart + 1;
    start = monthStart; end = t;
    prevStart = pStart; prevEnd = pStart + Math.min(dayOfMonth, prevLen) - 1;
    label = "이번 달";
  }
  return {
    start: dayNumberToString(start), end: dayNumberToString(end),
    prevStart: dayNumberToString(prevStart), prevEnd: dayNumberToString(prevEnd),
    title: label + " (" + dayNumberToString(start) + " ~ " + dayNumberToString(end) + ")"
  };
}

// Follows mergeInto up to MAX_MERGE_HOPS. A cycle returns the id itself; a missing target stops at
// the last id that has a row; a chain longer than the limit stops where it ran out.
function canonicalPerson(memberId, people) {
  var seen = Object.create(null);
  var current = memberId;
  seen[current] = true;
  for (var hop = 0; hop < MAX_MERGE_HOPS; hop++) {
    var row = people[current];
    if (!row || !row.mergeInto) return current;
    var next = row.mergeInto;
    if (next === current) return current;
    if (seen[next]) return memberId;
    if (!people[next]) return current;
    seen[next] = true;
    current = next;
  }
  return current;
}

function departmentOf(team, depts) {
  var d = depts[team];
  return d && d.name ? String(d.name).trim() : "";
}

// Summarizes assigned rows in [start, end] (yyyy-MM-dd strings compare correctly as text).
function summarizePeriod(data, start, end) {
  var persons = Object.create(null);   // canonical id -> { total, depts: name -> { dates, total } }
  var teams = Object.create(null);     // dept name -> { total, people: set }
  var unassignedPeople = Object.create(null);
  var unassignedTotal = 0;
  data.usage.forEach(function (r) {
    if (r.date < start || r.date > end) return;
    var person = canonicalPerson(r.memberId, data.people);
    var dept = departmentOf(r.team, data.depts);
    if (!dept) {
      unassignedPeople[person] = true;
      unassignedTotal += r.total;
      return;
    }
    var p = persons[person] || (persons[person] = { total: 0, depts: Object.create(null) });
    p.total += r.total;
    var pd = p.depts[dept] || (p.depts[dept] = { dates: Object.create(null), total: 0 });
    pd.dates[r.date] = true;
    pd.total += r.total;
    var t = teams[dept] || (teams[dept] = { total: 0, people: Object.create(null) });
    t.total += r.total;
    t.people[person] = true;
  });
  var total = 0, peopleCount = 0;
  Object.keys(persons).forEach(function (id) { total += persons[id].total; peopleCount++; });
  return {
    persons: persons, teams: teams, total: total, people: peopleCount,
    perPerson: peopleCount ? total / peopleCount : 0,
    teamCount: Object.keys(teams).length,
    unassigned: { people: Object.keys(unassignedPeople).length, total: unassignedTotal }
  };
}

function pctChange(cur, prev) {
  if (!prev) return null;
  return Math.round((cur - prev) / prev * 1000) / 10;
}

function personTeam(p) {
  var best = null, bestDays = -1, bestTotal = -1;
  Object.keys(p.depts).forEach(function (name) {
    var days = Object.keys(p.depts[name].dates).length, tot = p.depts[name].total;
    var better = days > bestDays || (days === bestDays && (tot > bestTotal || (tot === bestTotal && name < best)));
    if (better) { best = name; bestDays = days; bestTotal = tot; }
  });
  return best || "";
}

function nicknameOf(id, people) {
  var row = people[id];
  var nick = row && row.nickname ? String(row.nickname) : "";
  return nick || String(id).slice(0, 8);
}

function computeDashboard(data, kind, today) {
  var range = periodRange(kind, today);
  var cur = summarizePeriod(data, range.start, range.end);
  var prev = summarizePeriod(data, range.prevStart, range.prevEnd);

  var teams = Object.keys(cur.teams).map(function (name) {
    var t = cur.teams[name], n = Object.keys(t.people).length;
    return { name: name, total: t.total, perPerson: n ? t.total / n : 0, people: n };
  }).sort(function (a, b) { return b.total - a.total || (a.name < b.name ? -1 : a.name > b.name ? 1 : 0); });

  var list = Object.keys(cur.persons).map(function (id) {
    return { nickname: nicknameOf(id, data.people), team: personTeam(cur.persons[id]), total: cur.persons[id].total };
  });
  function byNick(a, b) { return a.nickname < b.nickname ? -1 : a.nickname > b.nickname ? 1 : 0; }
  var top = list.slice().sort(function (a, b) { return b.total - a.total || byNick(a, b); }).slice(0, 5);
  var inTop = new Set(top);
  var bottom = list.slice().sort(function (a, b) { return a.total - b.total || byNick(a, b); })
    .filter(function (p) { return !inTop.has(p); }).slice(0, 5);

  return {
    title: range.title,
    tiles: {
      total: cur.total, perPerson: cur.perPerson, people: cur.people, teamCount: cur.teamCount,
      deltaTotalPct: pctChange(cur.total, prev.total),
      deltaPerPersonPct: pctChange(cur.perPerson, prev.perPerson),
      deltaPeople: cur.people - prev.people
    },
    teams: teams, top: top, bottom: bottom, unassigned: cur.unassigned
  };
}

function formatDeltaPct(v) {
  if (v === null || v === undefined) return "—";
  return (v > 0 ? "+" : "") + v.toFixed(1) + "%";
}

function formatDeltaPeople(v) {
  return (v > 0 ? "+" : "") + v + "명";
}

function tokensText(n) { return (n / 1e6).toFixed(1) + "M"; }

function renderDashboard(sheet, model, nowMs, tz) {
  var n = model.teams.length;
  var teamEnd = 8 + n;
  // Below both the team table and the F:H person tables (the last one ends at row 22).
  var noteRow = Math.max(teamEnd, 21) + 2;
  var lastRow = Math.max(noteRow + 4, 21);
  ensureRows(sheet, lastRow);
  sheet.clear();
  sheet.getCharts().forEach(function (c) { sheet.removeChart(c); });

  var t = model.tiles;
  sheet.getRange(1, 1).setValue(asText(model.title));
  sheet.getRange(2, 1).setValue(asText("마지막 갱신: " + Utilities.formatDate(new Date(nowMs), tz, "yyyy-MM-dd HH:mm")));
  sheet.getRange(4, 1, 1, 4).setValues(asTextRows([["전체 토큰", "1인 평균", "쓰는 사람", "팀 수"]])).setFontWeight("bold");
  sheet.getRange(5, 1, 1, 4).setValues([[t.total, t.perPerson, t.people, t.teamCount]]);
  sheet.getRange(6, 1, 1, 4).setValues(asTextRows([[formatDeltaPct(t.deltaTotalPct), formatDeltaPct(t.deltaPerPersonPct),
    formatDeltaPeople(t.deltaPeople), ""]]));
  sheet.getRange(5, 1, 1, 2).setNumberFormat(TOKEN_FORMAT);

  var teamRows = [["부서", "총 토큰", "1인 평균", "인원"]];
  model.teams.forEach(function (x) { teamRows.push([x.name, x.total, x.perPerson, x.people]); });
  sheet.getRange(8, 1, n + 1, 4).setValues(asTextRows(teamRows));
  sheet.getRange(8, 1, 1, 4).setFontWeight("bold");
  if (n > 0) sheet.getRange(9, 2, n, 2).setNumberFormat(TOKEN_FORMAT);

  function personTable(row, title, people) {
    var rows = [[title, "부서", "토큰"]];
    people.forEach(function (p) { rows.push([p.nickname, p.team, p.total]); });
    sheet.getRange(row, 6, rows.length, 3).setValues(asTextRows(rows));
    sheet.getRange(row, 6, 1, 3).setFontWeight("bold");
    if (people.length) sheet.getRange(row + 1, 8, people.length, 1).setNumberFormat(TOKEN_FORMAT);
  }
  personTable(8, "많이 쓰는 팀원", model.top);
  personTable(16, "적게 쓰는 팀원", model.bottom);

  sheet.getRange(noteRow, 1).setValue(asText("미지정: " + model.unassigned.people + "명 · " + tokensText(model.unassigned.total) +
    " 토큰 — 부서 탭에 이름을 적으면 포함됩니다"));
  sheet.getRange(noteRow + 2, 1, 3, 1).setValues(asTextRows([
    ["앱이 없거나 팀 기능을 끈 사람은 아예 보이지 않습니다. 그래서 \"적게 쓰는 팀원\"에도 잡히지 않습니다."],
    ["인원과 평균은 \"앱이 보낸 사람\" 기준입니다."],
    ["숫자는 실제 청구액이 아니라 각자 기기의 로그에서 센 값입니다. 앱을 켜 둔 기기의 사용량만 잡힙니다."]
  ]));

  // Chart 2 is bound to a copy of the department and 1인 평균 columns sorted by the per-person value
  // (descending), far to the right (T:U) beyond the visible layout.
  var byPerson = model.teams.slice().sort(function (a, b) {
    return b.perPerson - a.perPerson || (a.name < b.name ? -1 : a.name > b.name ? 1 : 0);
  });
  var sorted = [["부서 (1인 평균순)", "1인 평균"]];
  byPerson.forEach(function (x) { sorted.push([x.name, x.perPerson]); });
  sheet.getRange(8, SORTED_COL, n + 1, 2).setValues(asTextRows(sorted));
  sheet.getRange(8, SORTED_COL, 1, 2).setFontWeight("bold");
  if (n > 0) sheet.getRange(9, SORTED_COL + 1, n, 1).setNumberFormat(TOKEN_FORMAT);

  // The two charts sit side by side: both are CHART_WIDTH x CHART_HEIGHT and start at J4, the second
  // CHART_WIDTH + 20 px to the right of the first.
  if (n > 0) {
    [
      { title: "팀별 총 사용량", labels: [8, 1], values: [8, 2], offsetX: 0 },
      { title: "팀별 1인 평균", labels: [8, SORTED_COL], values: [8, SORTED_COL + 1], offsetX: CHART_WIDTH + 20 }
    ].forEach(function (spec) {
      var chart = sheet.newChart()
        .setChartType(Charts.ChartType.BAR)
        .addRange(sheet.getRange(spec.labels[0], spec.labels[1], n + 1, 1))
        .addRange(sheet.getRange(spec.values[0], spec.values[1], n + 1, 1))
        .setPosition(4, 10, spec.offsetX, 0)
        .setOption("title", spec.title)
        .setOption("width", CHART_WIDTH)
        .setOption("height", CHART_HEIGHT)
        .setOption("legend", { position: "none" })
        .build();
      sheet.insertChart(chart);
    });
  }

  [120, 100, 100, 100, 30, 130, 110, 100].forEach(function (px, i) { sheet.setColumnWidth(i + 1, px); });
}

// Plan tab: per-account weekly-limit forecast and plan suggestion (spec 9.1).
// computePlan is pure; renderPlan writes the sheet.

var PLAN_WINDOW_MS = 7 * 86400000;
var PLAN_STALE_MS = 14 * 86400000;
var PLAN_COL_WIDTHS = [130, 110, 90, 110, 130, 90, 120, 120, 90, 120, 90, 150, 150];
var FORECAST_RANK = { "이미 다 씀": 0, "모자람": 1, "알맞음": 2, "남음": 3, "—": 4 };
var PLAN_HEADERS = ["닉네임", "부서", "도구", "플랜", "이메일 도메인", "이번 주 사용", "막대", "균등하게 썼다면", "리셋까지(일)",
  "이 속도면 리셋 때", "예상", "지난 4주 중 다 쓴 주", "제안"];

function toolDisplay(tool) {
  if (tool === "claude") return "Claude";
  if (tool === "codex") return "Codex";
  return String(tool);
}

function planIndex(order, plan) {
  var want = String(plan).trim().toLowerCase();
  for (var i = 0; i < order.length; i++) {
    if (String(order[i]).toLowerCase() === want) return i;
  }
  return -1;
}

function planSuggestion(plan, tool, fullWeeks, windows, s) {
  if (windows.length < s.suggest_weeks) return "기록 부족";
  var order = s["plan_order_" + tool];
  var idx = order ? planIndex(order, plan) : -1;
  if (fullWeeks >= s.suggest_up_full_weeks) {
    if (idx === -1) return "올리기 검토";
    return idx === order.length - 1 ? "최상위 플랜" : "올리기 검토 → " + order[idx + 1];
  }
  var allLow = windows.length > 0 && windows.every(function (w) { return w.maxUsed < s.suggest_down_max_pct; });
  if (allLow) {
    if (idx === -1) return "내리기 검토";
    return idx === 0 ? "필요한지 검토" : "내리기 검토 → " + order[idx - 1];
  }
  return "유지";
}

function planForecast(cur, projectedPct, s) {
  if (cur && cur.lastUsed >= s.full_week_pct) return "이미 다 씀";
  if (projectedPct === null) return "—";
  if (projectedPct >= s.forecast_short_pct) return "모자람";
  if (projectedPct >= s.forecast_fit_pct) return "알맞음";
  return "남음";
}

function computePlan(data, nowMs, tz) {
  var s = data.settings;
  var groups = new Map();
  data.limits.forEach(function (l) {
    var key = l.account + "|" + l.tool;
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key).push(l);
  });

  // A person's department is the dashboard rule (most days, then tokens, then name) over the last 28 days.
  var todayNum = dateToDayNumber(localDateString(nowMs, tz));
  var recent28 = summarizePeriod(data, dayNumberToString(todayNum - 27), dayNumberToString(todayNum));

  var rows = [];
  var excluded = 0;
  groups.forEach(function (list) {
    var latest = list.reduce(function (a, b) { return b.lastReadAt > a.lastReadAt ? b : a; });
    if (latest.lastReadAt < nowMs - PLAN_STALE_MS) return;   // an account nobody has read for 14 days is gone
    var person = canonicalPerson(latest.memberId, data.people);
    var dept = recent28.persons[person] ? personTeam(recent28.persons[person]) : departmentOf(latest.team, data.depts);
    if (!dept) { excluded++; return; }
    var cur = null;
    list.forEach(function (l) { if (l.resetsAt > nowMs && (!cur || l.resetsAt < cur.resetsAt)) cur = l; });
    var done = list.filter(function (l) { return l.resetsAt <= nowMs; })
      .sort(function (a, b) { return b.resetsAt - a.resetsAt; }).slice(0, s.suggest_weeks);
    var fullWeeks = done.filter(function (w) { return w.maxUsed >= s.full_week_pct; }).length;

    var pace = null, projected = null, daysToReset = null;
    if (cur) {
      pace = (PLAN_WINDOW_MS - (cur.resetsAt - cur.lastReadAt)) / PLAN_WINDOW_MS;
      daysToReset = (cur.resetsAt - nowMs) / 86400000;
      var fresh = nowMs - cur.lastReadAt <= s.stale_hours * 3600000;
      if (pace >= s.min_pace && pace <= 1 && fresh) projected = cur.lastUsed / pace;
    }
    rows.push({
      person: person, nickname: nicknameOf(person, data.people), team: dept, tool: latest.tool, plan: latest.plan,
      domain: latest.domain, usedPct: cur ? cur.lastUsed : null, daysToReset: daysToReset,
      pacePct: pace === null ? null : pace * 100, projectedPct: projected,
      forecast: planForecast(cur, projected, s),
      fullWeeks: fullWeeks, finishedWeeks: done.length,
      suggestion: planSuggestion(latest.plan, latest.tool, fullWeeks, done, s)
    });
  });

  rows.sort(function (a, b) {
    var r = FORECAST_RANK[a.forecast] - FORECAST_RANK[b.forecast];
    if (r) return r;
    if (a.projectedPct !== b.projectedPct) {
      if (a.projectedPct === null) return 1;
      if (b.projectedPct === null) return -1;
      return b.projectedPct - a.projectedPct;
    }
    return a.nickname < b.nickname ? -1 : a.nickname > b.nickname ? 1 : 0;
  });

  // Tiles: each person lands in the bucket of their worst account; "—" counts nowhere.
  var worst = new Map();
  rows.forEach(function (r) {
    var rank = FORECAST_RANK[r.forecast];
    if (rank === 4) return;
    if (!worst.has(r.person) || rank < worst.get(r.person)) worst.set(r.person, rank);
  });
  var tiles = { short: 0, fit: 0, spare: 0, noInfo: 0 };
  worst.forEach(function (rank) {
    if (rank <= 1) tiles.short++; else if (rank === 2) tiles.fit++; else tiles.spare++;
  });

  var today = dateToDayNumber(localDateString(nowMs, tz));
  var weekStart = dayNumberToString(today - 6);
  var recent = Object.create(null);
  data.usage.forEach(function (u) {
    if (u.date < weekStart || !departmentOf(u.team, data.depts)) return;
    recent[canonicalPerson(u.memberId, data.people)] = true;
  });
  var informed = Object.create(null);
  data.limits.forEach(function (l) {
    if (l.lastReadAt >= nowMs - PLAN_WINDOW_MS) informed[canonicalPerson(l.memberId, data.people)] = true;
  });
  Object.keys(recent).forEach(function (id) { if (!informed[id]) tiles.noInfo++; });

  rows.forEach(function (r) { delete r.person; });
  return { tiles: tiles, rows: rows, excludedAccounts: excluded, suggestWeeks: s.suggest_weeks };
}

function renderPlan(sheet, model, nowMs, tz) {
  var n = model.rows.length;
  var lastRow = Math.max(7 + n + 6, 20);
  ensureRows(sheet, lastRow);
  sheet.clear();
  sheet.getCharts().forEach(function (c) { sheet.removeChart(c); });

  sheet.getRange(1, 1).setValue(asText("플랜과 주간 한도 — 지금 진행 중인 주"));
  sheet.getRange(2, 1).setValue(asText("마지막 갱신: " + Utilities.formatDate(new Date(nowMs), tz, "yyyy-MM-dd HH:mm")));
  var t = model.tiles;
  sheet.getRange(4, 1, 1, 4).setValues(asTextRows([["이번 주 모자랄 사람", "알맞게 쓸 사람", "남길 사람", "플랜 정보 없음"]])).setFontWeight("bold");
  sheet.getRange(5, 1, 1, 4).setValues([[t.short, t.fit, t.spare, t.noInfo]]);
  sheet.getRange(7, 1, 1, PLAN_HEADERS.length).setValues(asTextRows([PLAN_HEADERS])).setFontWeight("bold");

  if (n > 0) {
    var body = model.rows.map(function (r) {
      return [r.nickname, r.team, toolDisplay(r.tool), r.plan, r.domain, r.usedPct, "", r.pacePct, r.daysToReset,
        r.projectedPct, r.forecast, r.fullWeeks + " / " + model.suggestWeeks, r.suggestion].map(function (v) { return v === null ? "" : v; });
    });
    sheet.getRange(8, 1, n, PLAN_HEADERS.length).setValues(asTextRows(body));
    [6, 8, 10].forEach(function (col) { sheet.getRange(8, col, n, 1).setNumberFormat('0.0"%"'); });
    sheet.getRange(8, 9, n, 1).setNumberFormat("0.0");
    for (var i = 0; i < n; i++) {
      var row = 8 + i;
      sheet.getRange(row, 7).setFormula('=SPARKLINE(F' + row + ',{"charttype","bar";"max",100})');
    }
  }

  var note = 8 + n + 1;
  sheet.getRange(note, 1).setValue(asText("미지정 부서라 빠진 계정: " + model.excludedAccounts + "개"));
  sheet.getRange(note + 2, 1, 3, 1).setValues(asTextRows([
    ["\"가장 높은 사용률\"은 앱이 켜져 있을 때 읽은 값 중 최대입니다. 주 끝 무렵에 앱이 꺼져 있었으면 실제보다 낮게 잡힙니다."],
    ["지난 4주 기록은 이 기능이 들어간 뒤부터 쌓입니다. 처음 4주 동안 제안은 \"기록 부족\"입니다."],
    ["한도 사용률과 리셋 시각은 Anthropic이 정한 값을 앱이 읽은 것입니다. Anthropic이 한도 규칙을 바꾸면 해석도 달라질 수 있습니다."]
  ]));

  PLAN_COL_WIDTHS.forEach(function (px, i) { sheet.setColumnWidth(i + 1, px); });
}

// Owner-facing entry points: setup, the hourly refresh, the menu, and sample data.

var SAMPLE_MEMBER_PREFIX = "00000000-0000-4000-8000-";
var SAMPLE_TEAM_PREFIX = "t_sample_";
var SAMPLE_ACCOUNT_PREFIX = "sample_";

// Which columns (1-based) carry sample keys in each data tab.
var SAMPLE_KEYS = [
  { tab: TAB_RAW, cols: COLS_RAW, keys: [[1, SAMPLE_MEMBER_PREFIX], [5, SAMPLE_TEAM_PREFIX]] },
  { tab: TAB_LIMITS, cols: COLS_LIMITS, keys: [[1, SAMPLE_ACCOUNT_PREFIX], [4, SAMPLE_MEMBER_PREFIX], [5, SAMPLE_TEAM_PREFIX]] },
  { tab: TAB_PEOPLE, cols: COLS_PEOPLE, keys: [[1, SAMPLE_MEMBER_PREFIX]] },
  { tab: TAB_DEPTS, cols: COLS_DEPTS, keys: [[1, SAMPLE_TEAM_PREFIX]] },
  { tab: TAB_TEAMLABELS, cols: COLS_TEAMLABELS, keys: [[1, SAMPLE_TEAM_PREFIX], [2, SAMPLE_MEMBER_PREFIX]] },
  { tab: TAB_DEVICES, cols: COLS_DEVICES, keys: [[1, SAMPLE_MEMBER_PREFIX]] }
];

function withScriptLock(fn) {
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    return fn();
  } finally {
    lock.releaseLock();
  }
}

// The 7 data tabs plus the 3 dashboards and the plan tab; existing tabs are left alone.
function ensureAllTabs(ss) {
  ensureSheets(ss);
  DASHBOARD_TABS.map(function (d) { return d.name; }).concat([TAB_PLAN]).forEach(function (name) {
    if (!ss.getSheetByName(name)) ss.insertSheet(name);
  });
}

// For each team, the most common non-empty label; ties go to the label that sorts first.
function suggestedTeamNames(teamLabels) {
  var counts = new Map();
  teamLabels.forEach(function (t) {
    var label = String(t.label).trim();
    if (!label) return;
    if (!counts.has(t.team)) counts.set(t.team, new Map());
    var m = counts.get(t.team);
    m.set(label, (m.get(label) || 0) + 1);
  });
  var out = new Map();
  counts.forEach(function (m, team) {
    var best = null, bestCount = 0;
    m.forEach(function (n, label) {
      if (n > bestCount || (n === bestCount && label < best)) { best = label; bestCount = n; }
    });
    out.set(team, best);
  });
  return out;
}

// Call inside the script lock: it re-reads 부서 so a row a report just added is kept, and it writes
// column C only, so the owner's 부서이름 is never touched.
function writeSuggestedTeamNames(ss, data) {
  var sheet = ss.getSheetByName(TAB_DEPTS);
  var rows = sheetRows(sheet, COLS_DEPTS.length);
  if (!rows.length) return;
  var names = suggestedTeamNames(data.teamLabels);
  var column = rows.map(function (r) { return [names.has(r[0]) ? names.get(r[0]) : r[2]]; });
  sheet.getRange(2, 3, rows.length, 1).setValues(asTextRows(column));
}

// Reading and rendering run without the script lock, so a slow refresh never makes a report wait: only
// the dashboards and the plan are written, and nobody else writes them. The lock is taken for the tab
// creation and for the 참고팀이름 write.
function refreshAll() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var tz = Session.getScriptTimeZone();
  var nowMs = Date.now();
  var today = localDateString(nowMs, tz);
  withScriptLock(function () { ensureAllTabs(ss); });
  var data = readAll(ss, tz);
  withScriptLock(function () { writeSuggestedTeamNames(ss, data); });
  DASHBOARD_TABS.forEach(function (d) {
    renderDashboard(ss.getSheetByName(d.name), computeDashboard(data, d.kind, today), nowMs, tz);
  });
  renderPlan(ss.getSheetByName(TAB_PLAN), computePlan(data, nowMs, tz), nowMs, tz);
}

// Deletes the untouched default tab, puts the dashboards and the plan first (data tabs after them) and
// opens 이번 달. Hidden tabs are left where they are.
function arrangeTabs(ss) {
  var ours = new Set(TAB_SPECS.map(function (t) { return t.name; }));
  DASHBOARD_TABS.forEach(function (d) { ours.add(d.name); });
  ours.add(TAB_PLAN);
  ss.getSheets().forEach(function (sh) {
    if (!ours.has(sh.getName()) && sh.getLastRow() === 0 && ss.getSheets().length > 1 &&
        (sh.getName() === "시트1" || sh.getName() === "Sheet1")) ss.deleteSheet(sh);
  });
  var order = DASHBOARD_TABS.map(function (d) { return d.name; }).concat([TAB_PLAN],
    TAB_SPECS.map(function (t) { return t.name; }).filter(function (n) { return !ss.getSheetByName(n).isSheetHidden(); }));
  order.forEach(function (name, i) {
    ss.setActiveSheet(ss.getSheetByName(name));
    ss.moveActiveSheet(i + 1);
  });
  ss.setActiveSheet(ss.getSheetByName(DASHBOARD_TABS[0].name));
}

function setup() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  withScriptLock(function () { ensureAllTabs(ss); });
  arrangeTabs(ss);
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === "refreshAll") ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger("refreshAll").timeBased().everyHours(1).create();
  refreshAll();
}

function onOpen(e) {
  SpreadsheetApp.getUi().createMenu("사용량 대시보드")
    .addItem("지금 새로 고침", "refreshAll")
    .addItem("샘플 데이터 넣기", "seedSampleData")
    .addItem("샘플 데이터 지우기", "clearSampleData")
    .addToUi();
}

function isSampleRow(spec, row) {
  return spec.keys.some(function (k) {
    var v = row[k[0] - 1];
    return typeof v === "string" && v.indexOf(k[1]) === 0;
  });
}

// Reads each tab, drops the sample rows and writes the rest back. Real rows keep their order.
function removeSampleRows(ss) {
  SAMPLE_KEYS.forEach(function (spec) {
    var sheet = ss.getSheetByName(spec.tab);
    if (!sheet) return;
    var width = spec.cols.length;
    var rows = sheetRows(sheet, width);
    var kept = rows.filter(function (r) { return !isSampleRow(spec, r); });
    if (kept.length === rows.length) return;
    // Kept rows first, then only the leftover tail is cleared: the body is never empty in between.
    if (kept.length) sheet.getRange(2, 1, kept.length, width).setValues(asTextRows(kept));
    sheet.getRange(kept.length + 2, 1, rows.length - kept.length, width).clearContent();
  });
}

function appendRows(sheet, width, rows) {
  if (!rows.length) return;
  var start = Math.max(sheet.getLastRow(), 1) + 1;
  ensureRows(sheet, start + rows.length - 1);
  sheet.getRange(start, 1, rows.length, width).setValues(asTextRows(rows));
}

function sampleMemberId(i) {
  return SAMPLE_MEMBER_PREFIX + ("000000000000" + (i + 1).toString(16)).slice(-12);
}

var SAMPLE_DEPTS = [
  { team: "t_sample_dev", name: "개발팀", label: "개발", people: ["해달", "지아", "모카"] },
  { team: "t_sample_edu", name: "교육운영팀", label: "교육", people: ["서연", "도윤", "하늘"] },
  { team: "t_sample_design", name: "디자인팀", label: "디자인", people: ["보리", "나래", "다온"] },
  { team: "t_sample_biz", name: "사업팀", label: "사업", people: ["이든", "채원", "별이"] }
];

function seedSampleData() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var tz = Session.getScriptTimeZone();
  var nowMs = Date.now();
  var today = localDateString(nowMs, tz);
  var firstDay = dateToDayNumber(periodRange("lastMonth", today).start);
  var todayNum = dateToDayNumber(today);
  var nowIso = msToIso(nowMs);
  var hourMs = 3600000;
  var weekMs = 7 * 24 * hourMs;

  withScriptLock(function () {
    ensureAllTabs(ss);
    removeSampleRows(ss);
    var raw = [], limits = [], people = [], depts = [], labels = [], devices = [];
    var idx = 0;
    SAMPLE_DEPTS.forEach(function (dept) {
      depts.push([dept.team, dept.name, dept.label, today]);
      dept.people.forEach(function (nick, pi) {
        var id = sampleMemberId(idx);
        var n = idx;
        people.push([id, nick, nowIso, "", "2.5.0", n % 3 === 2 ? "windows" : "mac"]);
        devices.push([id, sha256Hex("sample-secret-" + n), nowIso, nowIso]);
        if (pi === 0) labels.push([dept.team, id, dept.label, nowIso]);
        var level = 1 + ((n * 7) % 5);   // 1..5: a spread of heavy and light users
        for (var d = firstDay; d <= todayNum; d++) {
          if ((n + d) % 7 === 0) continue;   // some days off
          var date = dayNumberToString(d);
          var base = level * 1500000 + ((d * 31 + n * 17) % 9) * 400000;
          [["claude_code", base], ["codex", Math.round(base / 3)]].forEach(function (t) {
            var total = t[1];
            var input = Math.round(total * 0.05), output = Math.round(total * 0.03), cw = Math.round(total * 0.12);
            raw.push([id, nick, date, t[0], dept.team, input, output, cw, total - input - output - cw, total,
              "2.5.0", "mac", nowIso]);
          });
        }
        // 5 weekly windows per account: the current one resets 1-5 days ahead, the older four are finished.
        [["claude", "sample_c" + n, n % 2 ? "Max" : "Pro"], ["codex", "sample_x" + n, "plus"]].forEach(function (a, ai) {
          if (ai === 1 && n % 3 !== 0) return;
          var reset = Math.ceil((nowMs + (1 + n % 5) * 24 * hourMs) / hourMs) * hourMs;
          for (var w = 0; w < 5; w++) {
            var resetsAt = reset - w * weekMs;
            var used = w === 0 ? 15 + ((n * 13) % 70) : Math.min(100, 30 + ((n * 11 + w * 23) % 71));
            var readAt = w === 0 ? nowMs - hourMs : resetsAt - hourMs;
            limits.push([a[1], a[0], msToIso(resetsAt), id, dept.team, a[2], "sample.example",
              used, used, msToIso(readAt)]);
          }
        });
        idx++;
      });
    });
    appendRows(ss.getSheetByName(TAB_RAW), COLS_RAW.length, raw);
    appendRows(ss.getSheetByName(TAB_LIMITS), COLS_LIMITS.length, limits);
    appendRows(ss.getSheetByName(TAB_PEOPLE), COLS_PEOPLE.length, people);
    appendRows(ss.getSheetByName(TAB_DEPTS), COLS_DEPTS.length, depts);
    appendRows(ss.getSheetByName(TAB_TEAMLABELS), COLS_TEAMLABELS.length, labels);
    appendRows(ss.getSheetByName(TAB_DEVICES), COLS_DEVICES.length, devices);
  });
  refreshAll();
}

function clearSampleData() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  withScriptLock(function () { removeSampleRows(ss); });
  refreshAll();
}

// Web app entry points.

function jsonOutput(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
  if (!e || !e.postData || typeof e.postData.contents !== "string") return jsonOutput({ ok: false, error: "bad_json" });
  return jsonOutput(handleReport(SpreadsheetApp.getActiveSpreadsheet(), e.postData.contents, Date.now(), Session.getScriptTimeZone()));
}

function doGet() {
  return ContentService.createTextOutput("ok");
}
