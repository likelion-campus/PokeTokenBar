    };
  });
  var people = Object.create(null);
  rowsOf(TAB_PEOPLE, COLS_PEOPLE).forEach(function (r) {
    people[r[0]] = { nickname: String(r[1]), mergeInto: String(r[3] === undefined ? "" : r[3]).trim() };
  });
  var depts = Object.create(null);
  rowsOf(TAB_DEPTS, COLS_DEPTS).forEach(function (r) {
    depts[r[0]] = { name: String(r[1]).trim(), suggested: String(r[2]) };
  });
  var teamLabels = rowsOf(TAB_TEAMLABELS, COLS_TEAMLABELS).map(function (r) {
    return { team: r[0], memberId: r[1], label: String(r[2]) };
  });
  var settings = parseSettings(rowsOf(TAB_SETTINGS, COLS_SETTINGS));
  return { usage: usage, limits: limits, people: people, depts: depts, teamLabels: teamLabels, settings: settings };
}

// Period dashboards: pure computation (periodRange, computeDashboard) plus the sheet writer.
// All date math runs on "yyyy-MM-dd" strings through Date.UTC, never local-time Dates.

var TOKEN_FORMAT = '#,##0.0,,"M"';
var MAX_MERGE_HOPS = 5;

function dayNumberToString(n) {
  var d = new Date(n * DAY_MS);
  var m = d.getUTCMonth() + 1, day = d.getUTCDate();
  return d.getUTCFullYear() + "-" + (m < 10 ? "0" : "") + m + "-" + (day < 10 ? "0" : "") + day;
}

function monthStartNumber(y, m0) { return Date.UTC(y, m0, 1) / DAY_MS; }

function periodRange(kind, today) {
  var t = dateToDayNumber(today);
  var y = Number(today.slice(0, 4)), m0 = Number(today.slice(5, 7)) - 1;
  var start, end, prevStart, prevEnd, label;
  if (kind === "last7") {
    start = t - 6; end = t; prevStart = t - 13; prevEnd = t - 7; label = "지난 7일";
  } else if (kind === "lastMonth") {
    var thisStart = monthStartNumber(y, m0);
    var prevMonthStart = monthStartNumber(y, m0 - 1);
    start = prevMonthStart; end = thisStart - 1;
    prevStart = monthStartNumber(y, m0 - 2); prevEnd = prevMonthStart - 1;
    label = "지난달";
  } else {
    var monthStart = monthStartNumber(y, m0);
    var pStart = monthStartNumber(y, m0 - 1);
    var prevLen = monthStart - pStart;
    var dayOfMonth = t - monthStart + 1;
    start = monthStart; end = t;
    prevStart = pStart; prevEnd = pStart + Math.min(dayOfMonth, prevLen) - 1;
    label = "이번 달";
  }
  return {
    start: dayNumberToString(start), end: dayNumberToString(end),
    prevStart: dayNumberToString(prevStart), prevEnd: dayNumberToString(prevEnd),
    title: label + " (" + dayNumberToString(start) + " ~ " + dayNumberToString(end) + ")"
  };
}

// Follows mergeInto up to MAX_MERGE_HOPS. A cycle returns the id itself; a missing target stops at
// the last id that has a row; a chain longer than the limit stops where it ran out.
function canonicalPerson(memberId, people) {
  var seen = Object.create(null);
  var current = memberId;
  seen[current] = true;
  for (var hop = 0; hop < MAX_MERGE_HOPS; hop++) {
    var row = people[current];
    if (!row || !row.mergeInto) return current;
    var next = row.mergeInto;
    if (next === current) return current;
    if (seen[next]) return memberId;
    if (!people[next]) return current;
    seen[next] = true;
    current = next;
  }
  return current;
}

function departmentOf(team, depts) {
  var d = depts[team];
  return d && d.name ? String(d.name).trim() : "";
}

// Summarizes assigned rows in [start, end] (yyyy-MM-dd strings compare correctly as text).
function summarizePeriod(data, start, end) {
  var persons = Object.create(null);   // canonical id -> { total, depts: name -> { dates, total } }
  var teams = Object.create(null);     // dept name -> { total, people: set }
  var unassignedPeople = Object.create(null);
  var unassignedTotal = 0;
  data.usage.forEach(function (r) {
    if (r.date < start || r.date > end) return;
    var person = canonicalPerson(r.memberId, data.people);
    var dept = departmentOf(r.team, data.depts);
    if (!dept) {
      unassignedPeople[person] = true;
      unassignedTotal += r.total;
      return;
    }
    var p = persons[person] || (persons[person] = { total: 0, depts: Object.create(null) });
    p.total += r.total;
    var pd = p.depts[dept] || (p.depts[dept] = { dates: Object.create(null), total: 0 });
    pd.dates[r.date] = true;
    pd.total += r.total;
    var t = teams[dept] || (teams[dept] = { total: 0, people: Object.create(null) });
    t.total += r.total;
    t.people[person] = true;
  });
  var total = 0, peopleCount = 0;
  Object.keys(persons).forEach(function (id) { total += persons[id].total; peopleCount++; });
  return {
    persons: persons, teams: teams, total: total, people: peopleCount,
    perPerson: peopleCount ? total / peopleCount : 0,
    teamCount: Object.keys(teams).length,
    unassigned: { people: Object.keys(unassignedPeople).length, total: unassignedTotal }
  };
}

function pctChange(cur, prev) {
  if (!prev) return null;
  return Math.round((cur - prev) / prev * 1000) / 10;
}

function personTeam(p) {
  var best = null, bestDays = -1, bestTotal = -1;
  Object.keys(p.depts).forEach(function (name) {
    var days = Object.keys(p.depts[name].dates).length, tot = p.depts[name].total;
    var better = days > bestDays || (days === bestDays && (tot > bestTotal || (tot === bestTotal && name < best)));
    if (better) { best = name; bestDays = days; bestTotal = tot; }
  });
  return best || "";
}

function nicknameOf(id, people) {
  var row = people[id];
  var nick = row && row.nickname ? String(row.nickname) : "";
  return nick || String(id).slice(0, 8);
}

function computeDashboard(data, kind, today) {
  var range = periodRange(kind, today);
  var cur = summarizePeriod(data, range.start, range.end);
  var prev = summarizePeriod(data, range.prevStart, range.prevEnd);

  var teams = Object.keys(cur.teams).map(function (name) {
    var t = cur.teams[name], n = Object.keys(t.people).length;
    return { name: name, total: t.total, perPerson: n ? t.total / n : 0, people: n };
  }).sort(function (a, b) { return b.total - a.total || (a.name < b.name ? -1 : a.name > b.name ? 1 : 0); });

  var list = Object.keys(cur.persons).map(function (id) {
    return { nickname: nicknameOf(id, data.people), team: personTeam(cur.persons[id]), total: cur.persons[id].total };
  });
  function byNick(a, b) { return a.nickname < b.nickname ? -1 : a.nickname > b.nickname ? 1 : 0; }
  var top = list.slice().sort(function (a, b) { return b.total - a.total || byNick(a, b); }).slice(0, 5);
  var inTop = new Set(top);
  var bottom = list.slice().sort(function (a, b) { return a.total - b.total || byNick(a, b); })
    .filter(function (p) { return !inTop.has(p); }).slice(0, 5);

  return {
    title: range.title,
    tiles: {
      total: cur.total, perPerson: cur.perPerson, people: cur.people, teamCount: cur.teamCount,
      deltaTotalPct: pctChange(cur.total, prev.total),
      deltaPerPersonPct: pctChange(cur.perPerson, prev.perPerson),
      deltaPeople: cur.people - prev.people
    },
    teams: teams, top: top, bottom: bottom, unassigned: cur.unassigned
  };
}

function formatDeltaPct(v) {
  if (v === null || v === undefined) return "—";
  return (v > 0 ? "+" : "") + v.toFixed(1) + "%";
}

function formatDeltaPeople(v) {
  return (v > 0 ? "+" : "") + v + "명";
}

function tokensText(n) { return (n / 1e6).toFixed(1) + "M"; }

function renderDashboard(sheet, model, nowMs, tz) {
  var n = model.teams.length;
  var teamEnd = 8 + n;
  var noteRow = teamEnd + 2;
  var lastRow = Math.max(noteRow + 4, 21);
  ensureRows(sheet, lastRow);
  sheet.clear();
  sheet.getCharts().forEach(function (c) { sheet.removeChart(c); });

  var t = model.tiles;
  sheet.getRange(1, 1).setValue(asText(model.title));
  sheet.getRange(2, 1).setValue(asText("마지막 갱신: " + Utilities.formatDate(new Date(nowMs), tz, "yyyy-MM-dd HH:mm")));
  sheet.getRange(4, 1, 1, 4).setValues(asTextRows([["전체 토큰", "1인 평균", "쓰는 사람", "팀 수"]])).setFontWeight("bold");
  sheet.getRange(5, 1, 1, 4).setValues([[t.total, t.perPerson, t.people, t.teamCount]]);
  sheet.getRange(6, 1, 1, 4).setValues(asTextRows([[formatDeltaPct(t.deltaTotalPct), formatDeltaPct(t.deltaPerPersonPct),
    formatDeltaPeople(t.deltaPeople), ""]]));
  sheet.getRange(5, 1, 1, 2).setNumberFormat(TOKEN_FORMAT);

  var teamRows = [["부서", "총 토큰", "1인 평균", "인원"]];
  model.teams.forEach(function (x) { teamRows.push([x.name, x.total, x.perPerson, x.people]); });
  sheet.getRange(8, 1, n + 1, 4).setValues(asTextRows(teamRows));
  sheet.getRange(8, 1, 1, 4).setFontWeight("bold");
  if (n > 0) sheet.getRange(9, 2, n, 2).setNumberFormat(TOKEN_FORMAT);

  function personTable(row, title, people) {
    var rows = [[title, "부서", "토큰"]];
    people.forEach(function (p) { rows.push([p.nickname, p.team, p.total]); });
    sheet.getRange(row, 6, rows.length, 3).setValues(asTextRows(rows));
    sheet.getRange(row, 6, 1, 3).setFontWeight("bold");
    if (people.length) sheet.getRange(row + 1, 8, people.length, 1).setNumberFormat(TOKEN_FORMAT);
  }
  personTable(8, "많이 쓰는 팀원", model.top);
  personTable(16, "적게 쓰는 팀원", model.bottom);

  sheet.getRange(noteRow, 1).setValue(asText("미지정: " + model.unassigned.people + "명 · " + tokensText(model.unassigned.total) +
    " 토큰 — 부서 탭에 이름을 적으면 포함됩니다"));
  sheet.getRange(noteRow + 2, 1, 3, 1).setValues(asTextRows([
    ["앱이 없거나 팀 기능을 끈 사람은 아예 보이지 않습니다. 그래서 \"적게 쓰는 팀원\"에도 잡히지 않습니다."],
    ["인원과 평균은 \"앱이 보낸 사람\" 기준입니다."],
    ["숫자는 실제 청구액이 아니라 각자 기기의 로그에서 센 값입니다. 앱을 켜 둔 기기의 사용량만 잡힙니다."]
  ]));

  if (n > 0) {
    [{ col: 2, row: 4 }, { col: 3, row: 20 }].forEach(function (spec) {
      var chart = sheet.newChart()
        .setChartType(Charts.ChartType.BAR)
        .addRange(sheet.getRange(8, 1, n + 1, 1))
        .addRange(sheet.getRange(8, spec.col, n + 1, 1))
        .setPosition(spec.row, 10, 0, 0)
        .setOption("legend", { position: "none" })
        .build();
      sheet.insertChart(chart);
    });
  }
}

// Plan tab: per-account weekly-limit forecast and plan suggestion (spec 9.1).
// computePlan is pure; renderPlan writes the sheet.

var PLAN_WINDOW_MS = 7 * 86400000;
var FORECAST_RANK = { "이미 다 씀": 0, "모자람": 1, "알맞음": 2, "남음": 3, "—": 4 };
var PLAN_HEADERS = ["닉네임", "부서", "도구", "플랜", "이메일 도메인", "이번 주 사용", "막대", "균등하게 썼다면", "리셋까지(일)",
  "이 속도면 리셋 때", "예상", "지난 4주 중 다 쓴 주", "제안"];

function toolDisplay(tool) {
  if (tool === "claude") return "Claude";
  if (tool === "codex") return "Codex";
  return String(tool);
}

function planIndex(order, plan) {
  var want = String(plan).trim().toLowerCase();
  for (var i = 0; i < order.length; i++) {
    if (String(order[i]).toLowerCase() === want) return i;
  }
  return -1;
}

function planSuggestion(plan, tool, fullWeeks, windows, s) {
  if (windows.length < s.suggest_weeks) return "기록 부족";
  var order = s["plan_order_" + tool];
  var idx = order ? planIndex(order, plan) : -1;
  if (fullWeeks >= s.suggest_up_full_weeks) {
    if (idx === -1) return "올리기 검토";
    return idx === order.length - 1 ? "최상위 플랜" : "올리기 검토 → " + order[idx + 1];
  }
  var allLow = windows.length > 0 && windows.every(function (w) { return w.maxUsed < s.suggest_down_max_pct; });
  if (allLow) {
    if (idx === -1) return "내리기 검토";
    return idx === 0 ? "필요한지 검토" : "내리기 검토 → " + order[idx - 1];
  }
  return "유지";
}

function planForecast(cur, projectedPct, s) {
  if (cur && cur.lastUsed >= s.full_week_pct) return "이미 다 씀";
  if (projectedPct === null) return "—";
  if (projectedPct >= s.forecast_short_pct) return "모자람";
  if (projectedPct >= s.forecast_fit_pct) return "알맞음";
  return "남음";
}

function computePlan(data, nowMs, tz) {
  var s = data.settings;
  var groups = new Map();
  data.limits.forEach(function (l) {
    var key = l.account + "|" + l.tool;
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key).push(l);
  });

  var rows = [];
  var excluded = 0;
  groups.forEach(function (list) {
    var latest = list.reduce(function (a, b) { return b.lastReadAt > a.lastReadAt ? b : a; });
    var dept = departmentOf(latest.team, data.depts);
    if (!dept) { excluded++; return; }
    var cur = null;
    list.forEach(function (l) { if (l.resetsAt > nowMs && (!cur || l.resetsAt < cur.resetsAt)) cur = l; });
    var done = list.filter(function (l) { return l.resetsAt <= nowMs; })
      .sort(function (a, b) { return b.resetsAt - a.resetsAt; }).slice(0, s.suggest_weeks);
    var fullWeeks = done.filter(function (w) { return w.maxUsed >= s.full_week_pct; }).length;

    var pace = null, projected = null, daysToReset = null;
    if (cur) {
      pace = (PLAN_WINDOW_MS - (cur.resetsAt - cur.lastReadAt)) / PLAN_WINDOW_MS;
      daysToReset = (cur.resetsAt - nowMs) / 86400000;
      var fresh = nowMs - cur.lastReadAt <= s.stale_hours * 3600000;
      if (pace >= s.min_pace && pace <= 1 && fresh) projected = cur.lastUsed / pace;
    }
    var person = canonicalPerson(latest.memberId, data.people);
    rows.push({
      person: person, nickname: nicknameOf(person, data.people), team: dept, tool: latest.tool, plan: latest.plan,
      domain: latest.domain, usedPct: cur ? cur.lastUsed : null, daysToReset: daysToReset,
      pacePct: pace === null ? null : pace * 100, projectedPct: projected,
      forecast: planForecast(cur, projected, s),
      fullWeeks: fullWeeks, finishedWeeks: done.length,
      suggestion: planSuggestion(latest.plan, latest.tool, fullWeeks, done, s)
    });
  });

  rows.sort(function (a, b) {
    var r = FORECAST_RANK[a.forecast] - FORECAST_RANK[b.forecast];
    if (r) return r;
    if (a.projectedPct !== b.projectedPct) {
      if (a.projectedPct === null) return 1;
      if (b.projectedPct === null) return -1;
      return b.projectedPct - a.projectedPct;
    }
    return a.nickname < b.nickname ? -1 : a.nickname > b.nickname ? 1 : 0;
  });

  // Tiles: each person lands in the bucket of their worst account; "—" counts nowhere.
  var worst = new Map();
  rows.forEach(function (r) {
    var rank = FORECAST_RANK[r.forecast];
    if (rank === 4) return;
    if (!worst.has(r.person) || rank < worst.get(r.person)) worst.set(r.person, rank);
  });
  var tiles = { short: 0, fit: 0, spare: 0, noInfo: 0 };
  worst.forEach(function (rank) {
    if (rank <= 1) tiles.short++; else if (rank === 2) tiles.fit++; else tiles.spare++;
  });

  var today = dateToDayNumber(localDateString(nowMs, tz));
  var weekStart = dayNumberToString(today - 6);
  var recent = Object.create(null);
  data.usage.forEach(function (u) {
    if (u.date < weekStart || !departmentOf(u.team, data.depts)) return;
    recent[canonicalPerson(u.memberId, data.people)] = true;
  });
  var informed = Object.create(null);
  data.limits.forEach(function (l) {
    if (l.lastReadAt >= nowMs - PLAN_WINDOW_MS) informed[canonicalPerson(l.memberId, data.people)] = true;
  });
  Object.keys(recent).forEach(function (id) { if (!informed[id]) tiles.noInfo++; });

  rows.forEach(function (r) { delete r.person; });
  return { tiles: tiles, rows: rows, excludedAccounts: excluded, suggestWeeks: s.suggest_weeks };
}

function renderPlan(sheet, model, nowMs, tz) {
  var n = model.rows.length;
  var lastRow = Math.max(7 + n + 6, 20);
  ensureRows(sheet, lastRow);
  sheet.clear();
  sheet.getCharts().forEach(function (c) { sheet.removeChart(c); });

  sheet.getRange(1, 1).setValue(asText("플랜과 주간 한도 — 지금 진행 중인 주"));
  sheet.getRange(2, 1).setValue(asText("마지막 갱신: " + Utilities.formatDate(new Date(nowMs), tz, "yyyy-MM-dd HH:mm")));
  var t = model.tiles;
  sheet.getRange(4, 1, 1, 4).setValues(asTextRows([["이번 주 모자랄 사람", "알맞게 쓸 사람", "남길 사람", "플랜 정보 없음"]])).setFontWeight("bold");
  sheet.getRange(5, 1, 1, 4).setValues([[t.short, t.fit, t.spare, t.noInfo]]);
  sheet.getRange(7, 1, 1, PLAN_HEADERS.length).setValues(asTextRows([PLAN_HEADERS])).setFontWeight("bold");

  if (n > 0) {
    var body = model.rows.map(function (r) {
      return [r.nickname, r.team, toolDisplay(r.tool), r.plan, r.domain, r.usedPct, "", r.pacePct, r.daysToReset,
        r.projectedPct, r.forecast, r.fullWeeks + " / " + model.suggestWeeks, r.suggestion].map(function (v) { return v === null ? "" : v; });
    });
    sheet.getRange(8, 1, n, PLAN_HEADERS.length).setValues(asTextRows(body));
    [6, 8, 10].forEach(function (col) { sheet.getRange(8, col, n, 1).setNumberFormat('0.0"%"'); });
    sheet.getRange(8, 9, n, 1).setNumberFormat("0.0");
    for (var i = 0; i < n; i++) {
      var row = 8 + i;
      sheet.getRange(row, 7).setFormula('=SPARKLINE(F' + row + ',{"charttype","bar";"max",100})');
    }
  }

  var note = 8 + n + 1;
  sheet.getRange(note, 1).setValue(asText("미지정 부서라 빠진 계정: " + model.excludedAccounts + "개"));
  sheet.getRange(note + 2, 1, 3, 1).setValues(asTextRows([
    ["\"가장 높은 사용률\"은 앱이 켜져 있을 때 읽은 값 중 최대입니다. 주 끝 무렵에 앱이 꺼져 있었으면 실제보다 낮게 잡힙니다."],
    ["지난 4주 기록은 이 기능이 들어간 뒤부터 쌓입니다. 처음 4주 동안 제안은 \"기록 부족\"입니다."],
    ["한도 사용률과 리셋 시각은 Anthropic이 정한 값을 앱이 읽은 것입니다. Anthropic이 한도 규칙을 바꾸면 해석도 달라질 수 있습니다."]
  ]));
}

// Web app entry points.

function jsonOutput(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
  if (!e || !e.postData || typeof e.postData.contents !== "string") return jsonOutput({ ok: false, error: "bad_json" });
  return jsonOutput(handleReport(SpreadsheetApp.getActiveSpreadsheet(), e.postData.contents, Date.now(), Session.getScriptTimeZone()));
}

function doGet() {
  return ContentService.createTextOutput("ok");
}
